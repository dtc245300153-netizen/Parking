# Copy to backend/.env and replace every value before deployment
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./parking.db

# Local Ollama requires no API key; install Ollama and pull the model first.
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:3b

# Demo staffing estimate: one employee per this many arrivals in one hour
AI_ARRIVALS_PER_EMPLOYEE_PER_HOUR=10
