# Copy to backend/.env and replace every value before deployment
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./parking.db

# Optional Gemini API. Keep the key only in backend/.env.
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gemini-3.8-flash

# Demo staffing estimate: one employee per this many arrivals in one hour
AI_ARRIVALS_PER_EMPLOYEE_PER_HOUR=10
